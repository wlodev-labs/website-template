{
    "name": "website-template",
    "private": true,
    "scripts": {
        "dev": "turbo dev",
        "build": "turbo build",
        "format": "prettier --write \"**/*.{ts,tsx,md}\"",
        "check:types": "turbo run check:types"
    },
    "workspaces": [
        "apps/*"
    ],
    "devDependencies": {
        "prettier": "^3.7.3",
        "turbo": "2.9.6",
        "typescript": "5.9.3"
    },
    "packageManager": "pnpm@11.12.0",
    "engines": {
        "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
    },
    "allowScripts": {
        "esbuild": true,
        "fsevents": true,
        "sharp": true
    }
}
