---
import BaseLayout from '@/layouts/BaseLayout.astro'
import WlodevLogo from '@/assets/wlodev.png'
import { Image } from 'astro:assets'
import { payload } from '@/lib/payload'

const pages = await payload.find({
    collection: 'pages',
})
---

<BaseLayout>
    <div class='h-svh flex items-center justify-center bg-neutral-800'>
        <div
            class='max-w-lg mx-auto -mt-12 flex flex-col gap-4 items-center text-center'
        >
            <Image src={WlodevLogo} alt='Wlodev Logo' class='size-8' priority />
            <h1 class='text-2xl text-neutral-100 font-semibold'>
                Wlodev Website Template
            </h1>
            <p class='text-base text-neutral-200'>
                Start by going to the /admin dashboard and adding a new page.
                Here's the list of all the pages:
            </p>
            <ul class='flex flex-col gap-3'>
                {
                    pages.docs.map(page => (
                        <li>
                            <a
                                href={`/${page.slug}`}
                                class='pb-1 border-neutral-300 hover:border-b'
                            >
                                <span class='text-blue-500'>{page.title}</span>
                                <span class='text-neutral-300 pl-3'>
                                    /{page.slug}
                                </span>
                            </a>
                        </li>
                    ))
                }
            </ul>
        </div>
    </div>
</BaseLayout>
