        "@payloadcms/richtext-lexical": "3.88.0",
        "@wlodev/payload": "0.13.1",
        "cross-env": "^10.1.0",
        "graphql": "^17.0.2",
        "next": "16.3.0",
        "payload": "3.88.0",
        "react": "19.2.7",
        "react-dom": "19.2.7"
    },
    "devDependencies": {
        "@types/node": "26.1.0",
        "@types/react": "19.2.17",
        "@types/react-dom": "19.2.3",
        "typescript": "6.0.3"
    },
    "engines": {
        "node": ">=22.12.0"
    }
